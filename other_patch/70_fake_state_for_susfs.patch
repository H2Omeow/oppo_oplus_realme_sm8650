--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -1,6 +1,20 @@
 #include <linux/version.h>
 #include <linux/uidgid.h>
 
+/*
+ * susfs4oki's 50_add_susfs_in_gki patch injects, under CONFIG_KSU_SUSFS,
+ *   extern struct selinux_state fake_state;
+ * into security/selinux/hooks.c and security/selinux/selinuxfs.c.
+ * The matching definition only lives in that repo's
+ * KernelSU/10_enable_susfs_for_ksu.patch, which the workflow applies only for
+ * ksu_type == "ksu".  BakaSU / SukiSU / KernelSU-Next ship their own
+ * selinux_hide.c (they define ksu_selinux_hide_running but not fake_state), so
+ * with those branches the reference stays unresolved and vmlinux fails to link
+ * with "undefined symbol: fake_state".  Provide the missing definition here.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+struct selinux_state fake_state;
+#endif
+
 #include "../compat/kernel_compat.h"
